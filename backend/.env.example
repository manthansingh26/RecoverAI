# RecoverAI Backend — Environment Variables

# Application environment: development | staging | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# PostgreSQL connection string
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg://recoverai:recoverai@localhost:5432/recoverai

# Razorpay webhook secret for signature verification
# IMPORTANT: Replace with your actual webhook secret in production
RAZORPAY_WEBHOOK_SECRET=replace_with_a_local_development_secret

# Razorpay API credentials for Test Mode order creation / checkout
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_test_secret_here

# Execution mode: SIMULATION (safe default) | RAZORPAY (real API — requires credentials)
EXECUTION_MODE=SIMULATION

# Milestone 11: Automatic Recovery Scheduler
#
# SCHEDULER_ENABLED defaults to false. It must be explicitly set to true.
#
# Safety rationale: if EXECUTION_MODE is ever changed to RAZORPAY, an
# automatically-enabled scheduler could trigger real financial actions
# without explicit operator intent. Explicit opt-in prevents accidents.
#
# Development: set true to enable automatic execution of PENDING_EXECUTION
# cases (including human-approved ones) on every SCHEDULER_INTERVAL_SECONDS.
#
# Test environments: leave unset or set to false. Tests must remain
# deterministic; the scheduler must not run during pytest.
#
# Production: set to true only after confirming EXECUTION_MODE and
# Razorpay credentials are correctly configured.
#
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=30
