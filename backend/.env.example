# RecoverAI Backend — Environment Variables

# Application environment: development | staging | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# PostgreSQL connection string
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg://recoverai:recoverai@localhost:5432/recoverai

# Razorpay webhook secret for signature verification
# IMPORTANT: Replace with your actual webhook secret in production
RAZORPAY_WEBHOOK_SECRET=replace_with_a_local_development_secret

# Maximum accepted Razorpay webhook body size in bytes (default 1 MiB).
# Requests whose Content-Length exceeds this are rejected with 413 before the
# payload is buffered; the streamed body is also capped for chunked/missing
# Content-Length requests. Legitimate Razorpay webhooks are a few KB.
RAZORPAY_WEBHOOK_MAX_BODY_BYTES=1048576

# Milestone 15A: Webhook replay protection.
#
# Razorpay's documented replay rule: reject events whose top-level created_at
# is more than this many seconds in the past (default 5 minutes / 300s).
# Stale events are acknowledged with HTTP 200 (stale=true) so Razorpay stops
# retrying them. Must be >= 0.
WEBHOOK_MAX_EVENT_AGE_SECONDS=300

# Razorpay API credentials for Test Mode order creation / checkout
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_test_secret_here

# Execution mode: SIMULATION (safe default) | RAZORPAY (real API — requires credentials)
EXECUTION_MODE=SIMULATION

# Milestone 11: Automatic Recovery Scheduler
#
# SCHEDULER_ENABLED defaults to false. It must be explicitly set to true.
#
# Safety rationale: if EXECUTION_MODE is ever changed to RAZORPAY, an
# automatically-enabled scheduler could trigger real financial actions
# without explicit operator intent. Explicit opt-in prevents accidents.
#
# Development: set true to enable automatic execution of PENDING_EXECUTION
# cases (including human-approved ones) on every SCHEDULER_INTERVAL_SECONDS.
#
# Test environments: leave unset or set to false. Tests must remain
# deterministic; the scheduler must not run during pytest.
#
# Production: set to true only after confirming EXECUTION_MODE and
# Razorpay credentials are correctly configured.
#
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=30

# Cross-Origin Resource Sharing (CORS) — comma-separated list of allowed
# origins for production deployments.
#
# Development/test environments always allow local frontend origins
# (http://localhost:3000, http://127.0.0.1:3000, http://localhost:5173,
# http://127.0.0.1:5173).
#
# Production: allowed origins come ONLY from this setting. If left empty,
# no cross-origin requests are permitted (the CORS middleware is not added).
#
# NEVER set this to "*" (wildcard) — RecoverAI uses credentials, and a
# wildcard origin with allow_credentials=True is a security anti-pattern
# (any website can make authenticated requests).
#
# Example:
#   CORS_ORIGINS=https://app.recoverai.example.com,https://admin.recoverai.example.com
CORS_ORIGINS=""

# Milestone 14A: Authentication & Authorization
#
# Session cookie TTL (absolute) in seconds. Default 8 hours (28800).
# The cookie Max-Age and the session DB row's expires_at are set to this.
SESSION_COOKIE_TTL_SECONDS=28800
#
# Idle session TTL in seconds. If last_seen_at is older than this, the session
# is treated as expired even if the absolute TTL hasn't elapsed. Default 30 min.
SESSION_IDLE_TTL_SECONDS=1800
#
# Minimum interval (seconds) between last_seen_at updates. Prevents a DB write
# on every authenticated request. Default 60 seconds.
SESSION_LAST_SEEN_THROTTLE_SECONDS=60
#
# Login brute-force protection: max failed attempts before lockout.
LOGIN_MAX_ATTEMPTS=5
# The time window (seconds) in which failures are counted.
LOGIN_ATTEMPT_WINDOW_SECONDS=900
# How long (seconds) a locked-out key stays locked.
LOGIN_LOCKOUT_SECONDS=900
#
# Trusted Hosts — comma-separated list of allowed Host header values for
# TrustedHostMiddleware. Production must pin the real hostname.
# Empty = no host filtering (dev convenience; production assertion rejects this).
TRUSTED_HOSTS=""
#
# Allowed origins for server-side Origin/Referer validation on state-changing
# endpoints (CSRF protection). Same-origin or sibling subdomains only.
# Example: http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=""

# Milestone 15B: Operational reliability — stuck-case diagnostics.
#
# RECEIVED cases older than this many seconds are flagged as stuck.
STUCK_CASE_RECEIVED_SECONDS=3600
# REQUIRES_HUMAN cases older than this many seconds are flagged as stuck.
STUCK_CASE_HUMAN_REVIEW_SECONDS=86400
# Maximum number of stuck-case results to return.
STUCK_CASE_MAX_RESULTS=100

# Milestone 16A: AI advisory layer.
#
# The LLM is an ADVISOR ONLY. The deterministic PolicyEngine remains the
# final authority. All LLM_* settings have safe defaults (AI disabled).
#
# LLM provider abstraction. Initial provider: anthropic (Claude).
LLM_PROVIDER=anthropic
# API key for the LLM provider. Empty = AI disabled (deterministic only).
LLM_API_KEY=""
# Model used for root-cause diagnosis. Claude Sonnet 5 (dateless pinned ID
# per Anthropic official docs; the dated "claude-sonnet-5-20250825" was not
# a valid documented ID and was corrected to "claude-sonnet-5").
LLM_MODEL_DIAGNOSIS=claude-sonnet-5
# Model used for operator-facing explanations. Claude Haiku 4.5 (exact API ID).
LLM_MODEL_EXPLAIN=claude-haiku-4-5-20251001
# Timeout in seconds for each LLM API call.
LLM_TIMEOUT_SECONDS=30
# True = use LLM with deterministic fallback on failure (safe default).
# False = deterministic only (no LLM calls made).
LLM_FALLBACK_ENABLED=true
# When LLM confidence is below this threshold, downstream integration
# escalates to REQUIRES_HUMAN. (Not enforced in the advisory layer itself.)
LLM_CONFIDENCE_THRESHOLD=0.6
# Opt-in live smoke test. True + valid LLM_API_KEY runs one real provider call.
# Default false — the normal test suite never makes external API calls.
LLM_LIVE_TEST=false
